-- allium: 3

entity HasNext {
    supports_has_next_free_function: Boolean
    supports_next_collection_domain: Boolean
    supports_next_producer_domain: Boolean
    returns_boolean_preflight: Boolean
    returns_true_when_next_result_has_observable_element: Boolean
    returns_false_for_empty_or_singleton_collection: Boolean
    returns_false_when_producer_next_result_is_empty: Boolean
    collection_preflight_observes_count_without_constructing_next_result: Boolean
    producer_preflight_constructs_next_and_checks_first_observable_element: Boolean
    producer_preflight_does_not_count_entire_result: Boolean
    producer_callback_behavior_follows_next_and_first_observation: Boolean
    preserves_input_value_owned_state: Boolean
    no_heap_allocation: Boolean
    no_rtti: Boolean
    no_exceptions: Boolean
    constexpr_capable: Boolean
    rejects_unsupported_domain_with_targeted_diagnostic: Boolean
    diagnostic_names_supported_domains: Boolean

    invariant HasNextFreeFunctionSupported {
        this.supports_has_next_free_function = true
    }

    invariant SupportsNextCollectionDomain {
        this.supports_next_collection_domain = true
    }

    invariant SupportsNextProducerDomain {
        this.supports_next_producer_domain = true
    }

    invariant ReturnsBooleanPreflight {
        this.returns_boolean_preflight = true
    }

    invariant ReturnsTrueWhenNextResultHasObservableElement {
        this.returns_true_when_next_result_has_observable_element = true
    }

    invariant ReturnsFalseForEmptyOrSingletonCollection {
        this.returns_false_for_empty_or_singleton_collection = true
    }

    invariant ReturnsFalseWhenProducerNextResultIsEmpty {
        this.returns_false_when_producer_next_result_is_empty = true
    }

    invariant CollectionPreflightObservesCountWithoutConstructingNextResult {
        this.collection_preflight_observes_count_without_constructing_next_result = true
    }

    invariant ProducerPreflightConstructsNextAndChecksFirstObservableElement {
        this.producer_preflight_constructs_next_and_checks_first_observable_element = true
    }

    invariant ProducerPreflightDoesNotCountEntireResult {
        this.producer_preflight_does_not_count_entire_result = true
    }

    invariant ProducerCallbackBehaviorFollowsNextAndFirstObservation {
        this.producer_callback_behavior_follows_next_and_first_observation = true
    }

    invariant PreservesInputValueOwnedState {
        this.preserves_input_value_owned_state = true
    }

    invariant NoHeapAllocation {
        this.no_heap_allocation = true
    }

    invariant NoRtti {
        this.no_rtti = true
    }

    invariant NoExceptions {
        this.no_exceptions = true
    }

    invariant ConstexprCapable {
        this.constexpr_capable = true
    }

    invariant RejectsUnsupportedDomainWithTargetedDiagnostic {
        this.rejects_unsupported_domain_with_targeted_diagnostic = true
    }

    invariant DiagnosticNamesSupportedDomains {
        this.diagnostic_names_supported_domains = true
    }
}

actor HasNextOperator { identified_by: HasNext }
